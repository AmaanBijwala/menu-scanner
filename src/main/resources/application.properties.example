# ─── Database ───────────────────────────────────────────────────────────────
db.url=jdbc:oracle:thin:@localhost:1521/xepdb1
db.username=your_db_user
db.password=your_db_password
db.pool.maxSize=10


# ─── Redis ──────────────────────────────────────────────────────────────────
redis.host=localhost
redis.port=6379

# ─── File Storage ───────────────────────────────────────────────────────────
# External directory — survives WAR redeployments
# Windows dev: C:/menuscanner-data/images
# Linux prod:  /opt/menuscanner-data/images
file.upload.images.path=/opt/menuscanner-data/images

# ─── Application ────────────────────────────────────────────────────────────
# Used when generating QR code URLs
app.base.url=http://localhost:8080/menu-scanner

# ─── Product 2: Google Review Scanner ───────────────────────────────────────
# Shown on the page of a sticker that isn't assigned yet (sales pitch).
# Phone with country code, digits only (e.g. 919876543210). Leave blank to hide.
review.contact.name=
review.contact.phone=
