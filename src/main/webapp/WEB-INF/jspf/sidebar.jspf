<%-- Mobile Top Bar (visible only on mobile via CSS) --%>
<header class="mobile-header">
    <span class="mob-brand">Menu Scanner</span>
    <button class="mob-avatar" id="profileTriggerMob" onclick="toggleProfileCard(event)" aria-label="Profile">&#128100;</button>
</header>

<aside class="sidebar" id="sidebar">
    <div class="sidebar-top">
        <button class="sidebar-toggle" onclick="toggleSidebar()" title="Toggle sidebar">&#9776;</button>
        <span class="sidebar-brand">Menu Scanner</span>
    </div>
    <nav class="sidebar-nav">
        <a href="${pageContext.request.contextPath}/dashboard" id="nav-dashboard">
            <span class="sidebar-nav-icon">&#9632;</span>
            <span class="sidebar-nav-label">Dashboard</span>
        </a>
        <a href="${pageContext.request.contextPath}/menu-items" id="nav-menu">
            <span class="sidebar-nav-icon">&#127869;</span>
            <span class="sidebar-nav-label">Menu Manager</span>
        </a>
        <a href="${pageContext.request.contextPath}/customers" id="nav-leads">
            <span class="sidebar-nav-icon">&#128101;</span>
            <span class="sidebar-nav-label">Leads</span>
        </a>
        <a href="${pageContext.request.contextPath}/dashboard" id="nav-qr">
            <span class="sidebar-nav-icon">&#9633;</span>
            <span class="sidebar-nav-label">QR Generator</span>
        </a>
        <a href="${pageContext.request.contextPath}/campaigns" id="nav-campaigns">
            <span class="sidebar-nav-icon">&#128227;</span>
            <span class="sidebar-nav-label">Campaigns</span>
        </a>
        <a href="${pageContext.request.contextPath}/profile" id="nav-profile">
            <span class="sidebar-nav-icon">&#9881;</span>
            <span class="sidebar-nav-label">Profile</span>
        </a>
    </nav>
    <div class="sidebar-footer">
        <form method="post" action="${pageContext.request.contextPath}/logout">
            <button type="submit">
                <span class="sidebar-nav-icon">&#8617;</span>
                <span class="sidebar-nav-label">Logout</span>
            </button>
        </form>
    </div>
</aside>

<%-- Mobile Bottom Navigation (visible only on mobile via CSS) --%>
<nav class="bottom-nav">
    <a href="${pageContext.request.contextPath}/dashboard" class="bn-item" id="bn-dashboard">
        <span class="bn-icon">&#9632;</span>
        <span class="bn-label">Home</span>
    </a>
    <a href="${pageContext.request.contextPath}/menu-items" class="bn-item" id="bn-menu">
        <span class="bn-icon">&#127869;</span>
        <span class="bn-label">Menu</span>
    </a>
    <a href="${pageContext.request.contextPath}/customers" class="bn-item" id="bn-leads">
        <span class="bn-icon">&#128101;</span>
        <span class="bn-label">Leads</span>
    </a>
    <div class="bn-item bn-logout-wrap">
        <button type="button" class="bn-logout-btn" id="profileTriggerBnav" onclick="toggleProfileCard(event)">
            <span class="bn-icon">&#128100;</span>
            <span class="bn-label">Profile</span>
        </button>
    </div>
</nav>

<%-- Desktop profile avatar trigger (top-right, desktop only) --%>
<button class="profile-avatar-btn" id="profileTrigger" onclick="toggleProfileCard(event)" aria-label="Profile">
    &#128100;
</button>

<%-- Profile dropdown card --%>
<div class="profile-card" id="profileCard">
    <div class="profile-card-header">
        <div class="profile-card-avatar">&#128100;</div>
        <div class="profile-card-info">
            <span class="profile-card-name"><c:out value="${sessionScope.restaurantName}"/></span>
            <span class="profile-card-email"><c:out value="${sessionScope.restaurantEmail}"/></span>
        </div>
    </div>
    <div class="profile-card-plan">
        <span class="plan-badge plan-<c:out value="${sessionScope.planType}"/>"><c:out value="${sessionScope.planType}"/> Plan</span>
    </div>
    <div class="profile-card-divider"></div>
    <a href="${pageContext.request.contextPath}/profile" class="profile-card-settings">&#9881;&nbsp; Profile Settings</a>
    <div class="profile-card-divider"></div>
    <form method="post" action="${pageContext.request.contextPath}/logout" class="profile-card-logout">
        <button type="submit">&#8617;&nbsp; Logout</button>
    </form>
</div>

<script>
(function() {
    if (localStorage.getItem('sidebarCollapsed') === 'true') {
        document.getElementById('sidebar').classList.add('collapsed');
    }
})();

function toggleProfileCard(e) {
    e.stopPropagation();
    var card = document.getElementById('profileCard');
    card.classList.toggle('open');
}

document.addEventListener('click', function(e) {
    var card = document.getElementById('profileCard');
    if (card && card.classList.contains('open') &&
        !card.contains(e.target) &&
        e.target.id !== 'profileTrigger' &&
        e.target.id !== 'profileTriggerMob') {
        card.classList.remove('open');
    }
});

function toggleSidebar() {
    var s = document.getElementById('sidebar');
    s.classList.toggle('collapsed');
    localStorage.setItem('sidebarCollapsed', s.classList.contains('collapsed'));
}

document.addEventListener('DOMContentLoaded', function () {
    var path = window.location.pathname;
    var bnDash  = document.getElementById('bn-dashboard');
    var bnMenu  = document.getElementById('bn-menu');
    var bnLeads = document.getElementById('bn-leads');
    if (path.indexOf('/dashboard') !== -1 && bnDash)  bnDash.classList.add('active');
    if (path.indexOf('/menu-items') !== -1 && bnMenu)  bnMenu.classList.add('active');
    if (path.indexOf('/customers')  !== -1 && bnLeads) bnLeads.classList.add('active');
});
</script>
